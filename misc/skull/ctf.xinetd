service ctf
{
    disable = no
    socket_type = stream
    protocol    = tcp
    wait        = no
    user        = ctf
    type        = UNLISTED
    port        = 40000
    bind        = 0.0.0.0
    server      = /ctf/7169d2872cdac0f85b135c02bc20c1a3/bash
    server_args = /ctf/19ecae731566ee058943b0ac569ea9ef/jail.sh
    banner_fail = /etc/banner_fail
    per_source  = 10                    # the maximum instances of this service per source IP address
    rlimit_cpu  = 1                     # the maximum number of CPU seconds that the service may use
}